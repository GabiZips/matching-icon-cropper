{
  "name": "matching-icon-cropper",
  "version": "0.5.0",
  "private": true,
  "description": "Aplicativo desktop para criar matching icons em PNG ou GIF animado.",
  "author": "GabiZips",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GabiZips/matching-icon-cropper.git"
  },
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "package": "node scripts/notices.cjs && npm run build && electron-builder --win portable --x64",
    "test": "node --test tests/unit.test.mjs",
    "test:app": "npm run build && node scripts/test-app.cjs"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.gabizips.matchingiconcropper",
    "productName": "Matching Icon Cropper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/app-icon.ico",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": "portable"
    },
    "artifactName": "${productName}-${version}-portable.${ext}"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "type": "module"
}
